; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Digital Human Test"
config/description="MetaHuman exported from UE5 5.7 → Blender → Godot 4.6 with MatMADNESS HumanShaders.
First fleet run; documenting gotchas in the KB technique doc."
; visionOS port (alex-mbp): main scene = the CompositorServices XR harness. Godot's OWN renderer
; skins the MetaHuman natively (the earlier godotrealitykit path rendered bind pose only → only
; grooms showed). Quest/canonical main scene is "res://scenes/vr.tscn" (restore to ship Quest).
; No main_loop_type override: the visionOS XR path uses the normal SceneTree + the visionOS XR
; interface (XRServer.find_interface("visionOS")), not godotrealitykit's RealitySceneTree.
run/main_scene="res://scenes/visionos.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=1280
window/size/mode=0
window/size/resizable=true
window/size/borderless=false

[rendering]

; Quest standalone: Forward+ (clustered) fails pipeline creation on the Adreno 740 Vulkan
; driver under 4.7-beta3 (scene_shader_forward_clustered.cpp:503 → "Failed to link shaders").
; The Mobile renderer is the supported standalone path. NOTE: the renderer is selected
; before feature tags apply, so the `.mobile` override alone was ignored — the BASE method
; must be forward_mobile. This project is Quest-only so that's fine.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; ASTC variants imported alongside S3TC so the macOS (universal/arm64) export can pack
; Apple-GPU textures. The Windows preset still packs S3TC only.
textures/vram_compression/import_etc2_astc=true
environment/subsurface_scattering/subsurface_scattering_quality=2
environment/subsurface_scattering/subsurface_scattering_scale=0.08
; Quest standalone used MSAA 2x + FSR scaling (vr.gd retunes per quality tier at runtime).
; visionOS: keep MSAA / FSR / screen-space-AA OFF *statically* here (the values below). On the
; CompositorServices fork these must NOT be set at RUNTIME on the live XR viewport — doing so crashes
; the device's layered compositor on the first frame (cp_frame_end_submission -> __BUG_IN_CLIENT__;
; the sim TOLERATES the touch, which masked it). visionos.gd therefore sets ONLY use_xr + vrs_mode and
; leaves these at the static defaults below. (This comment previously said visionos.gd force-sets them
; at runtime "so a stale default can't reintroduce the empty render" — that runtime force-set was
; ITSELF the device crash; removed in commit 5469923. KB: godot-avp-no-runtime-render-buffer-touch.)
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=false
scaling_3d/mode=0
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.015, 0.017, 0.022, 1)
; Shadow map shrunk 4096->2048 and soft-shadow filter 4->2 for the tiled mobile GPU.
; visionOS: ample GPU headroom on AVP — high-res directional shadow so it isn't blocky when ON.
; The harness toggles the directional light's shadow_enabled (OFF / HIGH) at runtime per settings.
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1

[xr]

; visionOS path: OpenXR DISABLED. visionOS uses its OWN XR interface — XRServer.find_interface
; ("visionOS") via CompositorServices — NOT OpenXR. With openxr/enabled true, Godot also auto-inits
; the OpenXR-OSX runtime on this Mac (~/godot-visionos-pilot/OpenXR-OSX), which starts a headset-
; streaming server and competes for output ("No viewport was marked with use_xr"). Quest path needs
; this true; the visionOS path needs it false. (One reason this is a separate `visionos` branch.)
openxr/enabled=false
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true
openxr/reference_space=2
; Hand tracking: declare support so the app launches/runs with hands (no "pick up your
; controllers" gate) — the goal is controller-free launch, not hand interaction per se.
openxr/extensions/hand_tracking=true
; Application SpaceWarp (Meta) — render at half rate, runtime reprojects to full Hz.
; CONFIRMED WORKING (36 render -> 72 displayed) BUT on the Mobile/Vulkan renderer it produces a
; view-locked black-blob reprojection artifact centered in the left eye. We now REQUEST the
; extension at session init (true) so it can be toggled LIVE with the right trigger — vr.gd
; force-disables it at boot via OpenXRFbSpaceWarpExtension.set_enabled(false), so the default
; experience is the clean native render and the user opts into the 36→72 reprojection (and its
; left-eye seam) on demand to judge the trade-off.
openxr/extensions/meta/application_space_warp=true

; NOTE: the godotrealitykit editor plugin + [reality_kit] section were removed for the
; CompositorServices XR path (Godot's own renderer). godotrealitykit rendered the MetaHuman at
; bind pose (no skinning) — see KB projects/metahuman-godot-pipeline/visionos-port.md.
